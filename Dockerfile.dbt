FROM python:3.10-slim

# 1. Installation de Java 17 (beaucoup plus stable pour Spark 3.5)
RUN apt-get update && apt-get install -y \
    openjdk-17-jre-headless \
    curl \
    git \
    procps \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 2. Détection dynamique du JAVA_HOME (plus de problème ARM vs AMD)
# Cette astuce permet de trouver le chemin peu importe l'architecture
# Dans Dockerfile.dbt, après l'installation de Java :
RUN ln -s $(readlink -f /usr/bin/java | sed "s:/bin/java::") /usr/lib/jvm/default-java
ENV JAVA_HOME=/usr/lib/jvm/default-java


# 3. Installation des dépendances avec des versions alignées
# On ajoute dbt-core pour être sûr de la compatibilité
RUN pip install --no-cache-dir \
    "dbt-core>=1.7.0" \
    "dbt-spark[session]>=1.7.0" \
    "pyspark==3.5.0" \
    "delta-spark==3.0.0"

WORKDIR /app/dbt
COPY dbt/ /app/dbt/
ENV DBT_PROFILES_DIR=/app/dbt

# 4. Script de lancement simplifié
COPY <<EOF /usr/local/bin/run-dbt.sh
#!/bin/bash
# On laisse le système trouver Java via le PATH ou le ENV défini plus haut
dbt "\$@"
EOF

RUN chmod +x /usr/local/bin/run-dbt.sh
ENTRYPOINT ["/usr/local/bin/run-dbt.sh"]
