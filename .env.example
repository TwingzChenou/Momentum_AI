# ==============================================================================
# Momentum AI - Production Environment Template (.env.example)
# Copy this file to '.env' and fill in your credential values.
# ==============================================================================

# --- FINANCIAL MODELING PREP API ---
FMP_API_KEY="your_fmp_api_key_here_uuid_string"

# --- GOOGLE CLOUD PLATFORM (GCP) CONFIGURATION ---
GCP_PROJECT_ID="finance-ml-project-999999"
BUCKET_NAME="finance-data-lake-momentum-prod"
GCP_KEY_PATH="./config/keys_gcp/gcp-service-account-key.json"

# --- GCS INTEROPERABILITY KEYS (HMAC FOR SPARK/DELTA COMPATIBILITY) ---
GCS_ACCESS_KEY_ID="GOOG_ACCESS_KEY_ID_PLACEHOLDER"
GCS_SECRET_ACCESS_KEY="gcs_secret_access_key_placeholder_value_here"

# --- APACHE SPARK CONFIGURATION ---
# Path to your local Java runtime directory (Required for PySpark execution)
JAVA_HOME="/usr/lib/jvm/java-17-openjdk-amd64"

# --- MLFLOW SERVICE TRACKING ---
MLFLOW_TRACKING_URI="http://localhost:5001"
